#!/usr/bin/env python3
"""Stream cava's 64-band spectrum to Umbriel's effect-audio v2 socket.

Umbriel does not capture audio itself. This bridge runs a private cava
instance and forwards each frame as a complete effect-audio snapshot.
"""

import glob
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time

BARS = 64
ASCII_MAX = 1000.0
GAIN = float(os.environ.get("UMBRIEL_AUDIO_GAIN", "3.0"))
FRAME_INTERVAL = 1.0 / 60.0
HEARTBEAT = 0.1
DEBUG = os.environ.get("UMBRIEL_AUDIO_DEBUG") == "1"
CAVA_BIN = os.environ.get("UMBRIEL_CAVA_BIN", "cava")
CAVA_CONF = os.environ.get(
    "UMBRIEL_CAVA_CONF",
    os.path.expanduser("~/.local/share/umbriel/cava-audio.conf"),
)

stop = threading.Event()
latest = None
latest_lock = threading.Lock()
latest_changed = threading.Event()
cava_proc = None


def log(message):
    print(f"umbriel-audio-bridge: {message}", file=sys.stderr, flush=True)


def socket_path():
    explicit = os.environ.get("UMBRIEL_SOCKET")
    if explicit:
        return explicit
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    display = os.environ.get("WAYLAND_DISPLAY")
    if display:
        candidate = os.path.join(runtime, f"umbriel-{display}.sock")
        if os.path.exists(candidate):
            return candidate
    matches = sorted(glob.glob(os.path.join(runtime, "umbriel-*.sock")))
    return matches[0] if matches else os.path.join(runtime, "umbriel-wayland-0.sock")


def parse_line(line):
    values = []
    for token in line.strip().split(";"):
        if not token:
            continue
        try:
            value = float(token) / ASCII_MAX * GAIN
        except ValueError:
            value = 0.0
        values.append(0.0 if value < 0.0 else 1.0 if value > 1.0 else value)
        if len(values) == BARS:
            break
    if len(values) < BARS:
        values.extend([0.0] * (BARS - len(values)))
    return values


def cava_reader(proc):
    global latest
    try:
        for line in proc.stdout:
            if stop.is_set():
                break
            if not line.strip():
                continue
            values = parse_line(line)
            with latest_lock:
                latest = values
            latest_changed.set()
    except Exception as exc:
        log(f"reading cava output failed: {exc}")


def cava_supervisor():
    global cava_proc
    while not stop.is_set():
        try:
            cava_proc = subprocess.Popen(
                [CAVA_BIN, "-p", CAVA_CONF],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1,
            )
        except FileNotFoundError:
            log("cava is not installed; retrying in 5s")
            stop.wait(5.0)
            continue
        except Exception as exc:
            log(f"cannot start cava: {exc}; retrying in 5s")
            stop.wait(5.0)
            continue

        reader = threading.Thread(target=cava_reader, args=(cava_proc,), daemon=True)
        reader.start()
        while cava_proc.poll() is None and not stop.is_set():
            stop.wait(0.5)
        if stop.is_set():
            break
        log(f"cava exited with {cava_proc.returncode}; restarting in 1s")
        stop.wait(1.0)


def read_reply(sock):
    buffer = b""
    while b"\n" not in buffer:
        chunk = sock.recv(4096)
        if not chunk:
            raise ConnectionError("Umbriel closed the connection")
        buffer += chunk
        if len(buffer) > 65536:
            raise ValueError("Umbriel reply is too large")
    return json.loads(buffer.split(b"\n", 1)[0])


def connect():
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(2.0)
    sock.connect(socket_path())
    return sock


def on_signal(_signum, _frame):
    stop.set()
    latest_changed.set()


def main():
    global cava_proc
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    supervisor = threading.Thread(target=cava_supervisor, daemon=True)
    supervisor.start()

    sock = None
    sent = 0
    next_debug = time.monotonic() + 2.0

    while not stop.is_set():
        latest_changed.wait(HEARTBEAT)
        latest_changed.clear()

        with latest_lock:
            bands = latest
        if bands is None:
            continue

        if sock is None:
            try:
                sock = connect()
                log(f"connected to {socket_path()}")
            except OSError as exc:
                log(f"waiting for Umbriel socket: {exc}")
                stop.wait(1.0)
                continue

        payload = json.dumps(
            {
                "cmd": "effect-audio",
                "version": 2,
                "bands": [round(value, 3) for value in bands],
            },
            separators=(",", ":"),
        ) + "\n"
        encoded = payload.encode()
        if len(encoded) > 4096:
            log("snapshot exceeds the 4096-byte limit; dropping")
            continue

        started = time.monotonic()
        try:
            sock.sendall(encoded)
            reply = read_reply(sock)
            if reply.get("ok") is not True:
                raise RuntimeError(reply.get("err", reply))
            sent += 1
        except Exception as exc:
            log(f"feed lost: {exc}; reconnecting")
            try:
                sock.close()
            except OSError:
                pass
            sock = None
            stop.wait(0.5)
            continue

        if DEBUG and started >= next_debug:
            log(f"snapshots={sent} max_band={max(bands):.3f}")
            next_debug = started + 2.0

        elapsed = time.monotonic() - started
        if elapsed < FRAME_INTERVAL:
            stop.wait(FRAME_INTERVAL - elapsed)

    if sock is not None:
        try:
            sock.close()
        except OSError:
            pass
    if cava_proc is not None and cava_proc.poll() is None:
        cava_proc.terminate()
        try:
            cava_proc.wait(timeout=2.0)
        except subprocess.TimeoutExpired:
            cava_proc.kill()


if __name__ == "__main__":
    main()
